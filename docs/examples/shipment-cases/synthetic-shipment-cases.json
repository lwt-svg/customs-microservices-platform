{
  "dataset": {
    "dataset_id": "SYNTHETIC-SHIPMENT-CASES-001",
    "title": "Chapter 24 synthetic shipment case benchmark",
    "data_classification": "SYNTHETIC_DEMO",
    "contains_enterprise_data": false,
    "allowed_usage": [
      "LEARNING",
      "AUTOMATED_TEST",
      "UI_DEMO",
      "AGENT_EVAL"
    ],
    "prohibited_usage": [
      "REAL_BOOKING",
      "REAL_CUSTOMS_DECLARATION",
      "REAL_LOADING",
      "PRODUCTION_ACCURACY_CLAIM"
    ],
    "source": {
      "source_type": "MANUALLY_CONSTRUCTED",
      "source_reference": "CHAPTER_24_SCENARIO_DESIGN",
      "contains_enterprise_data": false
    }
  },
  "cases": [
    {
      "case_number": "SHP-DEMO-FCL-001",
      "case_name": "构造海运整柜正常路径",
      "owner_organization_code": "DEMO_LOGISTICS",
      "transport_scenario": "SEA_FCL",
      "description": "完全构造的整柜案件，用于验证装载与订舱可以并行、外部提交前必须人工确认。",
      "expected_route": {
        "document_intake": "REQUIRED",
        "load_planning": "REQUIRED",
        "link_booking": "REQUIRED",
        "customs_preparation": "REQUIRED",
        "container_planning": "NOT_IMPLEMENTED",
        "human_approval_before_external_submit": true
      },
      "expected_assertions": [
        "CASE_CREATED_AS_DRAFT",
        "LOAD_PLANNING_TASK_CAN_BE_BOUND",
        "LINK_BOOKING_APPLICATION_CAN_BE_BOUND",
        "CASE_CAN_BE_ACTIVATED",
        "NO_EXTERNAL_SUBMIT_WITHOUT_HUMAN_APPROVAL"
      ]
    },
    {
      "case_number": "SHP-DEMO-PALLET-001",
      "case_name": "构造已有托盘路径",
      "owner_organization_code": "DEMO_SUPPLY_CHAIN",
      "transport_scenario": "SEA_LCL",
      "description": "货物已经形成托盘，路由不应再次要求运行箱到托盘优化。",
      "expected_route": {
        "document_intake": "REQUIRED",
        "carton_to_pallet_planning": "SKIP",
        "pallet_validation": "REQUIRED",
        "link_booking": "OPTIONAL",
        "container_planning": "SKIP"
      },
      "expected_assertions": [
        "EXISTING_PALLET_DATA_IS_NOT_OVERWRITTEN",
        "CARTON_TO_PALLET_TOOL_IS_NOT_CALLED"
      ]
    },
    {
      "case_number": "SHP-DEMO-AIR-001",
      "case_name": "构造空运跳步路径",
      "owner_organization_code": "DEMO_LOGISTICS",
      "transport_scenario": "AIR",
      "description": "用于验证空运案件不会错误进入海运集装箱、VGM 或 LINK 海运七步。",
      "expected_route": {
        "document_intake": "REQUIRED",
        "load_planning": "OPTIONAL",
        "sea_container_planning": "SKIP",
        "solas_vgm": "SKIP",
        "link_sea_booking": "SKIP",
        "customs_preparation": "REQUIRED"
      },
      "expected_assertions": [
        "SEA_ONLY_TOOLS_ARE_NOT_CALLED",
        "CUSTOMS_PREPARATION_REMAINS_AVAILABLE"
      ]
    },
    {
      "case_number": "SHP-DEMO-CONFLICT-001",
      "case_name": "构造跨文档毛重冲突",
      "owner_organization_code": "DEMO_CUSTOMS",
      "transport_scenario": "UNDECIDED",
      "description": "Packing List 与 Commercial Invoice 的构造毛重不同，系统必须保留两份证据并转人工。",
      "synthetic_conflicts": [
        {
          "field_name": "gross_weight_kg",
          "candidate_a": {
            "value": 1240,
            "source": "packing-list.pdf",
            "locator": "page=2,row=TOTAL"
          },
          "candidate_b": {
            "value": 1180,
            "source": "commercial-invoice.xlsx",
            "locator": "sheet=Invoice,cell=H26"
          }
        }
      ],
      "expected_route": {
        "cross_document_reconciliation": "REQUIRED",
        "human_resolution": "REQUIRED",
        "external_submit": "BLOCKED"
      },
      "expected_assertions": [
        "CONFLICT_IS_REPORTED",
        "BOTH_EVIDENCE_LOCATORS_ARE_RETAINED",
        "NO_VALUE_IS_SILENTLY_SELECTED"
      ]
    },
    {
      "case_number": "SHP-DEMO-RETRY-001",
      "case_name": "构造订舱超时与幂等重试",
      "owner_organization_code": "DEMO_CUSTOMS",
      "transport_scenario": "SEA_FCL",
      "description": "首次模拟承运人调用超时，重试必须复用同一订舱申请和幂等键。",
      "fault_injection": {
        "carrier_first_attempt": "TIMEOUT",
        "carrier_second_attempt": "ACCEPTED"
      },
      "expected_route": {
        "link_booking": "REQUIRED",
        "retry": "REQUIRED",
        "manual_intervention_on_dead": "REQUIRED"
      },
      "expected_assertions": [
        "ONE_BOOKING_APPLICATION_ONLY",
        "IDEMPOTENCY_KEY_IS_REUSED",
        "CASE_IDENTITY_IS_UNCHANGED",
        "RETRY_IS_AUDITED"
      ]
    }
  ]
}
