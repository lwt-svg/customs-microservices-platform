# This file contains only safe local example values.
# Copy it to .env.local before starting Docker Compose.

# MySQL is local to Docker and is never an enterprise database.
MYSQL_ROOT_PASSWORD=local-root-password-change-me
MYSQL_DATABASE=customs_affairs_lab
MYSQL_USER=lab_user
MYSQL_PASSWORD=local-lab-password-change-me

# Nacos below is the local Docker instance, not Alibaba Cloud Nacos.
NACOS_AUTH_TOKEN=VGhpcy1pcy1hLWxvbmctbG9jYWwtZGVtby10b2tlbi1mb3ItbmFjb3M=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# The FastAPI service uses these values when it starts on the host machine.
# LINK 服务只能使用自己的独立 schema。首次迁移前须按 README 创建该 schema。
LINK_DATABASE_URL=mysql+asyncmy://lab_user:local-lab-password-change-me@127.0.0.1:3306/link_booking_service
# 第 24 章：Shipment Case 由统一 Python Agent Runtime 保存，绑定 LINK 申请时直接访问
# LINK 内部 API。Docker/K8s 部署时只替换为对应服务 DNS，不需要改领域代码。
LINK_BOOKING_INTERNAL_BASE_URL=http://127.0.0.1:8000
SHIPMENT_RESOURCE_VERIFY_TIMEOUT_SECONDS=3

# Java BFF 调用 Shipment Case Python 接口的专用 HTTP 超时。
# 使用 Spring Duration 格式，例如 500ms、2s、1m。
SHIPMENT_CASE_CONNECT_TIMEOUT=2s
SHIPMENT_CASE_READ_TIMEOUT=15s

# 第 23 章：供应链智能装载服务使用自己的独立 schema。
# 旧版 .env.local 没有这一项也能使用一键脚本：脚本会只在当前进程内根据 MYSQL_* 构造它，
# 不会覆盖或改写你的 .env.local。
LOAD_PLANNING_DATABASE_URL=mysql+asyncmy://lab_user:local-lab-password-change-me@127.0.0.1:3306/load_planning_service
LOAD_PLANNING_NACOS_DISCOVERY_ENABLED=true
LOAD_PLANNING_NACOS_SERVICE_NAME=load-planning-service
LOAD_PLANNING_NACOS_REGISTER_IP=127.0.0.1
LOAD_PLANNING_NACOS_REGISTER_PORT=8200
# LangGraph 只编排现有确定性 Service，不调用大模型。SQLite checkpoint 是本地嵌入式文件，
# 不需要再启动一个网站或中间件；旧 .env.local 不写这两项也会使用安全默认值。
LOAD_PLANNING_LANGGRAPH_ENABLED=true
LOAD_PLANNING_LANGGRAPH_CHECKPOINT_PATH=../../runtime/checkpoints/load-planning-langgraph.sqlite3
# Shipment Agent 自动唤醒器跟随同一个 8200 FastAPI 进程启动，不新增端口或命令。
# 这些都是可选调优项；旧 .env.local 完全不写时会使用下列默认值。
SHIPMENT_AGENT_WAKE_WORKER_ENABLED=true
SHIPMENT_AGENT_WAKE_POLL_SECONDS=2
SHIPMENT_AGENT_WAKE_LEASE_SECONDS=30
SHIPMENT_AGENT_WAKE_BATCH_SIZE=20
SHIPMENT_AGENT_WAKE_WAIT_SECONDS=5
SHIPMENT_AGENT_WAKE_RESOURCE_BINDING_SECONDS=10
SHIPMENT_AGENT_WAKE_RECOVERY_GRACE_SECONDS=120
SHIPMENT_AGENT_WAKE_RETRY_BASE_SECONDS=2
SHIPMENT_AGENT_WAKE_RETRY_MAX_SECONDS=60

# 第 23.9 章：候选方案的可选智能解读。默认关闭，装载计算、LangGraph、审批和发布
# 都不依赖它。想用本机 Codex 试验时，无需修改 .env.local，直接运行：
#   ./scripts/run-local.sh core --with-codex
# 以后改用 Responses API 时，只在 .env.local 填写 OPENAI_API_KEY，再运行：
#   ./scripts/run-local.sh core --with-openai
# 第一次使用前需要单独执行一次 `codex login`。模型只接收匿名数值摘要。
LOAD_PLANNING_PLAN_INSIGHTS_ENABLED=false
LOAD_PLANNING_PLAN_INSIGHTS_PROVIDER=rule_based
LOAD_PLANNING_LLM_MODEL=gpt-6-luna
# 留空表示 Codex CLI 使用自己的默认模型；不要为了跟 Responses API 保持一致而强行填写。
LOAD_PLANNING_CODEX_MODEL=
LOAD_PLANNING_LLM_TIMEOUT_SECONDS=90
OPENAI_BASE_URL=https://api.openai.com/v1
# 仅当 provider=openai_responses 时使用。真实 Key 只能写进未提交的 .env.local 或密钥系统。
OPENAI_API_KEY=

# Java BFF 只连接自己的独立 schema；用户名和密码默认复用本机 MYSQL_USER、MYSQL_PASSWORD。
# 真实 .env.local 中可保留这两个安全的本机配置，不要写企业地址或企业凭据。
PLATFORM_DATABASE_URL=jdbc:mysql://127.0.0.1:3306/platform_bff_lab?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
PLATFORM_DATABASE_SCHEMA=platform_bff_lab
# 此 URL 仅保留给浏览器或旧脚本；Nacos Python SDK 不使用它。
NACOS_SERVER_ADDR=http://127.0.0.1:8848
# 当前 Java/Python 服务都使用 Nacos public namespace，不读取旧的 NACOS_NAMESPACE。
# 将来如果启用命名空间，必须在各服务中显式接入真实 namespace ID，不能只写显示名称。
NACOS_GROUP=CUSTOMS_AFFAIRS_LOCAL

# 13.3：Python 服务注册。Nacos SDK 必须使用“主机:端口”，不能带 http://。
# NACOS_USERNAME、NACOS_PASSWORD 复用上方本机 Nacos 凭据；请勿把真实值提交到 Git。
NACOS_DISCOVERY_ENABLED=true
NACOS_DISCOVERY_SERVER_ADDR=127.0.0.1:8848
NACOS_REGISTER_IP=127.0.0.1
NACOS_REGISTER_PORT=8000

# 第 22 章：独立模拟承运人。全部值仅供本机 DEMO，不得替换成真实承运人地址或 Token。
CARRIER_DATABASE_URL=mysql+asyncmy://lab_user:local-lab-password-change-me@127.0.0.1:3306/link_carrier_simulator
CARRIER_SIMULATOR_URL=http://127.0.0.1:8100
CARRIER_CALLBACK_URL=http://127.0.0.1:8000/api/v1/carrier-callbacks/link
CARRIER_CALLBACK_TOKEN=LOCAL-DEMO-CALLBACK-TOKEN-CHANGE-ME

# LINK → 模拟承运人投递失败后的后台自动重试。
# core 模式设为 false：VALIDATE 只保存 PENDING；full 模式的一键脚本会临时覆盖为 true。
CARRIER_DISPATCH_ENABLED=false
CARRIER_DISPATCH_RETRY_ENABLED=true
CARRIER_DISPATCH_RETRY_INTERVAL_SECONDS=5

# 模拟承运人 → LINK 回调失败后的后台自动重试和 SENDING 租约恢复。
CARRIER_CALLBACK_RETRY_WORKER_ENABLED=true
CARRIER_CALLBACK_RETRY_POLL_SECONDS=2
CARRIER_CALLBACK_LEASE_SECONDS=15
