# This file contains only safe local example values.
# Copy it to .env.local before starting Docker Compose.

# MySQL is local to Docker and is never an enterprise database.
MYSQL_ROOT_PASSWORD=local-root-password-change-me
MYSQL_DATABASE=customs_affairs_lab
MYSQL_USER=lab_user
MYSQL_PASSWORD=local-lab-password-change-me

# Nacos below is the local Docker instance, not Alibaba Cloud Nacos.
NACOS_AUTH_TOKEN=VGhpcy1pcy1hLWxvbmctbG9jYWwtZGVtby10b2tlbi1mb3ItbmFjb3M=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# The FastAPI service uses these values when it starts on the host machine.
# LINK 服务只能使用自己的独立 schema。首次迁移前须按 README 创建该 schema。
LINK_DATABASE_URL=mysql+asyncmy://lab_user:local-lab-password-change-me@127.0.0.1:3306/link_booking_service

# Java BFF 只连接自己的独立 schema；用户名和密码默认复用本机 MYSQL_USER、MYSQL_PASSWORD。
# 真实 .env.local 中可保留这两个安全的本机配置，不要写企业地址或企业凭据。
PLATFORM_DATABASE_URL=jdbc:mysql://127.0.0.1:3306/platform_bff_lab?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
PLATFORM_DATABASE_SCHEMA=platform_bff_lab
# 此 URL 仅保留给浏览器或旧脚本；Nacos Python SDK 不使用它。
NACOS_SERVER_ADDR=http://127.0.0.1:8848
NACOS_NAMESPACE=customs-affairs-os-local
NACOS_GROUP=CUSTOMS_AFFAIRS_LOCAL

# 13.3：Python 服务注册。Nacos SDK 必须使用“主机:端口”，不能带 http://。
# NACOS_USERNAME、NACOS_PASSWORD 复用上方本机 Nacos 凭据；请勿把真实值提交到 Git。
NACOS_DISCOVERY_ENABLED=true
NACOS_DISCOVERY_SERVER_ADDR=127.0.0.1:8848
NACOS_REGISTER_IP=127.0.0.1
NACOS_REGISTER_PORT=8000
